# Copy to .env locally; never commit .env or paste a secret into chat.
# The app is not implemented yet. These names are the approved D1 interface
# for the future backend/deployment work.

# Application and provenance
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
DATA_MODE=sample
FRONTEND_ORIGIN=http://localhost:3000

# Hack Midwest workshop inference candidate. Keep the API key backend-only.
# Confirm endpoint, aliases, quota, and policy with organizers before use.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding
IMAGE_MODEL=hackathon-image

# Akamai Cloud management. This is a distinct Linode PAT for provisioning;
# it is not the workshop inference key. Leave blank until provisioning is approved.
LINODE_CLI_TOKEN=
AKAMAI_CLOUD_REGION=

# Optional retrieval storage. Do not configure for the initial fixture MVP.
# The workshop reference uses PostgreSQL + pgvector with 1024-dimensional
# embeddings from its hackathon-embedding alias. Provisioning remains approval-gated.
VECTOR_DB_LABEL=hackmidwest-vector-db
VECTOR_DB_PLAN=
VECTOR_DB_ALLOWED_CIDR=
DATABASE_URL=
PGSSLMODE=require

# Research API freshness window in seconds. Code default is 86400 (24h); use 604800
# (7 days) while this demo reads stored evidence without a daily ingest. Tighten again
# before enabling a scheduled ingest; older evidence returns 409 stale_data.
DECISION_STALE_AFTER_SECONDS=604800

VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# Local Folio Robinhood MCP connection. Generate 32 random bytes and base64
# encode them for BROKER_ENCRYPTION_KEY. Keep this feature disabled in public
# deployments until Robinhood has approved the hosted platform.
BROKER_ENCRYPTION_KEY=
ROBINHOOD_MCP_ENABLED=false
ROBINHOOD_REDIRECT_URI=http://localhost:3100/api/broker/robinhood/callback
# This bypasses email verification only when AUTH_URL is loopback. Keep false
# for every hosted environment.
LOCAL_ACCOUNT_AUTH=false
