# Copy to .env locally. Never commit .env or paste credentials into chat/Discord.

# Akamai workshop inference: backend-only; values supplied by the organizers.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding
IMAGE_MODEL=hackathon-image

# Akamai Cloud / Linode management PAT: separate from the workshop inference key.
# Grant only Account Read Only and Databases Read/Write for vector database work.
LINODE_CLI_TOKEN=
AKAMAI_CLOUD_REGION=

# Managed PostgreSQL + pgvector. Do not set DATABASE_URL manually; it is obtained
# from the created database after the authorized preflight/provisioning step.
VECTOR_DB_LABEL=hackmidwest-vector-db
VECTOR_DB_PLAN=
VECTOR_DB_ALLOWED_CIDR=
DATABASE_URL=
PGSSLMODE=require
