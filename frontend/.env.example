AUTH_SECRET=
# Must be the same value provided to the Research API. Generate independently
# from AUTH_SECRET and keep it out of source control.
SERVICE_ASSERTION_SECRET=
AUTH_URL=http://localhost:3000
# Local Docker only: permits creating a loopback-only test account without an
# email provider. The route rejects this setting for non-loopback AUTH_URLs.
LOCAL_ACCOUNT_AUTH=true
DATABASE_URL=postgresql://folio:***@localhost:5432/folio
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
RESEARCH_API_URL=http://127.0.0.1:8000
SERVICE_ASSERTION_SECRET=
# Local development only: use live SEC/RSS/Yahoo source data on stock pages.
DEMO_LIVE_RESEARCH=false
SCRAPER_API_URL=http://127.0.0.1:8001
# Production read-only live research; only serve previously ingested records.
PUBLIC_LIVE_RESEARCH=false
ALLOW_REGISTRATION=false
DIGEST_JOB_SECRET=
