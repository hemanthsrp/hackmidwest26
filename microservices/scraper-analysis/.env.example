# AWS Bedrock (Strands Agents model provider)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Akamai Cloud Managed PostgreSQL (+ pgvector) -- single server-only URL;
# must include sslmode=require for any non-localhost host (enforced in
# config.py). Never log, commit, or document the real value.
DATABASE_URL=
# Only the root loopback-bound Compose setup sets this true for its private
# Docker service host `database`. Keep false for every other deployment.
ALLOW_INSECURE_LOCAL_DATABASE=false

# Akamai hosted AI inference (OpenAI-compatible: /v1/embeddings etc.)
AKAMAI_INFERENCE_BASE_URL=
AKAMAI_INFERENCE_API_KEY=
AKAMAI_EMBEDDING_MODEL=
AKAMAI_CHAT_MODEL=
AKAMAI_IMAGE_MODEL=

# Reddit -- unofficial public .json scraping, no OAuth (see
# sources/reddit_unofficial.py for why: official API registration requires
# Reddit's manual Responsible Builder Policy approval, not viable for a
# hackathon timeline). Only a descriptive User-Agent is needed.
REDDIT_USER_AGENT=scraper-analysis/0.1 by <contact>

# Financial news API (MarketAux or equivalent)
NEWS_API_KEY=

# NOAA Climate Data Online token (free): https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# SEC EDGAR requires a descriptive contact User-Agent, not a key
SEC_EDGAR_USER_AGENT="hackmidwest-scraper-analysis <contact-email>"

# Jev (TypeSafe System One) through the shared microservices/jev-tool package.
# Optional: needs `pip install -e ../jev-tool`. When enabled, new news/social
# evidence gains details.jev (relevance, direction, content type, event type,
# upcoming event, materiality). Never commit the key.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Only if you want Jev to fill `sentiment` when Bedrock tagging left it empty.
JEV_FILL_SENTIMENT=false
# Relevance below this marks a record off-topic for its symbol (kept, labelled).
JEV_RELEVANCE_GATE=0.3

# Feature flags
ENABLE_X_SCRAPER=false
ENABLE_REDDIT_SCRAPER=false

# Background ingestion. Off by default; when on it writes to DATABASE_URL on a
# timer, in strict mode only (live data, fixtures never substituted/persisted).
ENABLE_SCHEDULER=false
SCHEDULER_SYMBOLS=AAPL
SCHEDULER_INTERVAL_MINUTES=30
SCHEDULER_OFFHOURS_FACTOR=4
SCHEDULER_TAG=true
