# AWS Bedrock (Strands Agents model provider)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Akamai Cloud Managed PostgreSQL (+ pgvector) -- single server-only URL;
# must include sslmode=require for any non-localhost host (enforced in
# config.py). Never log, commit, or document the real value.
DATABASE_URL=

# Akamai hosted AI inference (OpenAI-compatible: /v1/embeddings etc.)
AKAMAI_INFERENCE_BASE_URL=
AKAMAI_INFERENCE_API_KEY=
AKAMAI_EMBEDDING_MODEL=
AKAMAI_CHAT_MODEL=
AKAMAI_IMAGE_MODEL=

# Reddit (PRAW) — reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=scraper-analysis/0.1 by <reddit-username>

# Financial news API (MarketAux or equivalent)
NEWS_API_KEY=

# SEC EDGAR requires a descriptive contact User-Agent, not a key
SEC_EDGAR_USER_AGENT="hackmidwest-scraper-analysis <contact-email>"

# Feature flags
ENABLE_X_SCRAPER=false
